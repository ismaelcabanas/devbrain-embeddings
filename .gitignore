.chroma/
chroma_db/
faiss_indexes/
*.db
*.sqlite

# Caché de modelos locales de Hugging Face / Sentence Transformers
.cache/
.huggingface/

# ====================================================================
# Datos de prueba de la aplicación (Fase 2)
# ====================================================================
